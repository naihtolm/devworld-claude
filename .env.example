# --- Database (Neon or Supabase — copy the connection string from their dashboard) ---
# If you're on Supabase and deploying to Vercel (or any platform without
# outbound IPv6), use the connection pooler string (dashboard -> Connect ->
# "Transaction pooler"), NOT the direct connection ("db.<ref>.supabase.co").
# The direct host resolves IPv6-only and is unreachable from Vercel's
# runtime — it'll work fine locally (most ISPs/dev machines have IPv6) and
# then fail with ENOTFOUND in production, which is a confusing way to find
# this out. The pooler string looks like:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:5432/devworld?sslmode=require"

# --- Auth (Clerk — from your Clerk dashboard's API Keys page) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Storage (Supabase Storage — for project attachments) ---
# If your DATABASE_URL above is already a Supabase Postgres instance, use
# that same project: dashboard -> Settings -> API. Project URL, service_role
# key (NOT the anon key — this is used server-side only). The upload bucket
# is created automatically on first use.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Payments (Stripe Connect — enable Connect first: dashboard -> Settings
# -> Connect. Use test-mode keys. STRIPE_WEBHOOK_SECRET comes from either
# `stripe listen --forward-to localhost:PORT/api/webhooks/stripe` (dev) or a
# webhook endpoint you create in the dashboard pointed at that same path,
# listening for at least checkout.session.completed and account.updated) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
